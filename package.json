{
  "name": "snag",
  "version": "1.8.3",
  "description": "Snag — a simple, powerful video & audio downloader powered by yt-dlp",
  "author": "flodisterhoft-ops",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "validate:tools": "node scripts/prepare-tools.mjs --validate-manifest",
    "prepare:tools": "node scripts/prepare-tools.mjs",
    "dist": "npm run prepare:tools && electron-vite build && electron-builder --win",
    "dist:dir": "npm run prepare:tools && electron-vite build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
